# Options: 'local', 'openai', 'anthropic'
LLM_PROVIDER=local
LLM_MODEL=gemma3:1b

# ===================================
# EMBEDDINGS
# ===================================
# Options: 'local' or 'openai'
EMBEDDINGS_PROVIDER=local
EMBEDDINGS_MODEL=nomic

